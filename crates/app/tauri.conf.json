{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Cube",
  "version": "0.2.0-alpha.1",
  "identifier": "io.github.rajanbor.agentworkbench",
  "build": {
    "beforeDevCommand": "pnpm -F open-cube-web dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm -F open-cube-web build",
    "frontendDist": "../../web/out"
  },
  "app": {
    "windows": [
      {
        "title": "Open Cube",
        "label": "main",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "underWindowBackground"
          ],
          "state": "followsWindowActiveState",
          "radius": 12
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
