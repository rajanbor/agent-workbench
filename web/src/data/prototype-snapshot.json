  "library": {
    "skills": [
      {
        "id": "repo-map",
        "name": "Repository map",
        "category": "context",
        "summary": "Indexes the workspace tree and keeps a short map of where things live.",
        "detail": "Runs once per session and refreshes on branch change. Reads paths and file names only, never file contents outside the granted mounts.",
        "requires": [
          "Files: workspace"
        ],
        "installed": true
      },
      {
        "id": "diff-review",
        "name": "Diff review",
        "category": "review",
        "summary": "Reads a pending diff and comments on it before anything is written.",
        "detail": "Pairs with the review-before-write pattern: the agent must produce a diff, and this skill is what reads it back.",
        "requires": [
          "Files: workspace",
          "Pattern: review-before-write"
        ],
        "installed": true
      },
      {
        "id": "design-tokens",
        "name": "Design tokens",
        "category": "design",
        "summary": "Knows the token file and refuses colour literals in a review.",
        "detail": "Loads desktop/src/styles/tokens.css and checks proposed CSS against it.",
        "requires": [
          "Files: workspace"
        ],
        "installed": true
      },
      {
        "id": "cargo-tests",
        "name": "Cargo tests",
        "category": "verification",
        "summary": "Runs the Rust test suite and reports failures with the failing assertion.",
        "detail": "Needs shell approval per run until workbenchd owns the sandbox pty.",
        "requires": [
          "Shell: approval"
        ],
        "installed": false
      },
      {
        "id": "accessibility-audit",
        "name": "Accessibility audit",
        "category": "review",
        "summary": "Checks contrast, focus order and hit targets on changed screens.",
        "detail": "Reports findings as notes; it never edits a file.",
        "requires": [
          "Files: workspace"
        ],
        "installed": true
      },
      {
        "id": "changelog-writer",
        "name": "Changelog writer",
        "category": "writing",
        "summary": "Drafts release notes from commits and the changelog.",
        "detail": "Reads the commit list from the version-control state, not from the network.",
        "requires": [
          "Git: read"
        ],
        "installed": true
      }
    ],
    "patterns": [
      {
        "id": "review-before-write",
        "name": "Review before write",
        "summary": "The agent proposes a diff and waits for approval before writing.",
        "effect": "Every write becomes a two-step exchange; nothing lands unseen."
      },
      {
        "id": "one-change-per-run",
        "name": "One change per run",
        "summary": "A run touches a single module or file group, then stops.",
        "effect": "Keeps diffs reviewable and makes a failed run cheap to discard."
      },
      {
        "id": "test-before-propose",
        "name": "Test before propose",
        "summary": "The test suite must pass before a diff is offered.",
        "effect": "Adds a verification step and reports the failure instead of the diff when it breaks."
      },
      {
        "id": "approval-for-shell",
        "name": "Approval for shell",
        "summary": "Each shell command is presented for approval before it runs.",
        "effect": "Turns the shell permission from a grant into a per-command decision."
      },
      {
        "id": "read-only",
        "name": "Read only",
        "summary": "The agent may read the workspace but never write to it.",
        "effect": "Removes write tools from the agent entirely; findings arrive as notes."
      },
      {
        "id": "report-findings",
        "name": "Report findings",
        "summary": "Results arrive as a structured list of findings with file and line.",
        "effect": "Makes output reviewable and comparable between runs."
      }
    ],
    "mcp": [
      {
        "id": "filesystem",
